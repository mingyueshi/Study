# make env 自动创建随机密钥；不要提交真实 .env.production。
COMPOSE_PROJECT_NAME=primary-system
PRIMARY_SECRET_KEY=CHANGE_ME
# 应用账号无超级用户权限；管理密码仅传给数据库和一次性运维容器。
PRIMARY_DB_NAME=primary_system
PRIMARY_DB_USER=primary_app
PRIMARY_DB_PASSWORD=CHANGE_DB_PASSWORD
PRIMARY_PG_ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD
PRIMARY_DB_MEMORY_LIMIT=1g
PRIMARY_ALLOWED_HOSTS=localhost,127.0.0.1,study.example.com
PRIMARY_CSRF_TRUSTED_ORIGINS=https://study.example.com
# 默认只允许同机 Nginx／宝塔连接；容器内部固定 8012。
PRIMARY_BIND=127.0.0.1
PRIMARY_PORT=8012
# 包括初始化与备份进程，限制文件缓存挤占宿主机内存；需要时可改为 2g。
PRIMARY_MEMORY_LIMIT=1g
# 正式部署保持 1。仅本地 HTTP 测试时设为 0。
PRIMARY_HTTPS=1
# 反向代理必须覆盖 X-Forwarded-Proto，不能原样透传客户端的值。
PRIMARY_TRUST_PROXY=1
