      "methods": [
        {
          "title": "缺数清单",
          "when": "一行或一列空格较少时。",
          "example": "4×4 数独的一行是 1、空格、3、4。",
          "steps": [
            "这行需要 1、2、3、4 各一次，所以只缺 2。",
            "还要核对该格所在列与宫没有 2，才能放心填入。"
          ]
        },
        {
          "title": "行、列、宫求交集",
          "when": "一行还缺不止一个数时。",
          "example": "一个空格所在行允许 2、4，所在列允许 1、4，所在宫允许 3、4。",
          "steps": [
            "取三个允许集合的交集，只剩 4。",
            "将 4 填入后，再更新受它影响的行、列和宫。"
          ]
        },
        {
          "title": "某个数字的唯一位置",
          "when": "每格都有多个候选，但某个数字的去处很少时。",
          "example": "某宫里的 3 被同行、同列已有的 3 排除了其他位置，只剩一个空格可放。",
          "steps": [
            "不只问「这个格能放什么」，也问「这个数字还能放哪里」。",
            "仅在同一行、列或宫中只剩一个合法位置时，才用这一规则确定。"
          ]
        }
      ],
