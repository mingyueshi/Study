{
  "schema_version": 1,
  "title": "数学思维训练营",
  "lead": "读懂条件，找到方法，说清理由。五条路线，让会做一道题慢慢变成会用一种方法。",
  "tracks": [
    {
      "id": "logic",
      "title": "逻辑推理",
      "symbol": "∴",
      "lead": "把线索变成限制，让每一步结论都有理由。",
      "foundation": "会读「不是」「在前面」「不相邻」，能逐条核对条件。",
      "transfer": "把排除、分类和反证带到奥数应用题，也用在日常信息判断中。",
      "habits": [
        "先写清每个对象只能对应一个选项，而且各选项不重复。",
        "确定的信息先放好，未知的信息暂时保留，不把猜测当结论。",
        "完成后回到每一条线索逐一检查；符合某一条还不够。"
      ],
      "methods": [
        {
          "title": "直接定位与排除",
          "when": "有明确身份或否定线索时。",
          "example": "甲、乙、丙各拿一张圆、方、三角卡。乙拿方卡，甲不拿圆卡。",
          "steps": [
            "先固定乙＝方；剩下圆与三角。",
            "甲不能拿圆，只能拿三角，因此丙拿圆。"
          ]
        },
        {
          "title": "一一对应与候选表",
          "when": "同一对象有多个可能，需要连锁排除时。",
          "example": "三本书各属于一人。若甲只能选 A、B，而乙已经确定选 A，甲就只剩 B。",
          "steps": [
            "每一行表示一个对象，列出尚未排除的候选。",
            "某对象确定后，从其他对象的候选中删去该选项。"
          ]
        },
        {
          "title": "顺序与反证",
          "when": "线索涉及前后、相邻或某种假设时。",
          "example": "甲在乙前面。假如甲在最后一位，乙就无处可排，所以这个假设不成立。",
          "steps": [
            "先安排最受限制的位置，再检查相邻和先后关系。",
            "试探必须标成假设，出现矛盾就撤回；穷尽其他可能后才下结论。"
          ]
        }
      ],
      "drills": [
        {
          "id": "logic-colors",
          "level": 1,
          "kind": "logic",
          "title": "谁拿了哪张色卡？",
          "goal": "从确定的一条开始排除。",
          "prompt": "小林、小雨、小禾各拿一张红、蓝、绿色卡，颜色不重复。为每个人选择色卡。",
          "puzzle": {
            "labels": [
              "小林",
              "小雨",
              "小禾"
            ],
            "choices": [
              "红色",
              "蓝色",
              "绿色"
            ],
            "constraints": [
              {
                "op": "eq",
                "a": 1,
                "value": 0,
                "text": "小雨拿的是红色卡。"
              },
              {
                "op": "ne",
                "a": 0,
                "value": 1,
                "text": "小林拿的不是蓝色卡。"
              }
            ],
            "solution": [
              2,
              0,
              1
            ]
          },
          "hints": [
            "先固定小雨的颜色。",
            "红色已用掉，小林只能从蓝色和绿色中选。",
            "小林不是蓝色，因此是绿色；剩下的颜色属于小禾。"
          ],
          "explanation": [
            "先由明确线索确定小雨＝红色，再根据不重复和否定线索确定小林＝绿色。",
            "小禾拿剩下的蓝色，回查两条线索都成立。"
          ],
          "answer_text": "小林＝绿色；小雨＝红色；小禾＝蓝色。",
          "reflection": "如果删去「小林不是蓝色」，剩下的线索还能确定唯一答案吗？"
        },
