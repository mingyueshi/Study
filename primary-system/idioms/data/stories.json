 "stories": [
  {
   "id": "fujing-qingzui",
   "headword": "负荆请罪",
   "figure_ids": [
    "lin-xiangru",
    "lian-po"
   ],
   "source_book": "《史记》",
   "source_chapter": "廉颇蔺相如列传",
   "quote": "廉颇闻之，肉袒负荆，因宾客至蔺相如门谢罪。",
   "story": "蔺相如立了大功，官位升到廉颇之上。老将军廉颇不服气，放话要当面羞辱他。蔺相如听说后，处处躲着廉颇，连门客都觉得丢脸。蔺相如解释说：秦国不敢欺负赵国，是因为有我们两人在。要是我们闹翻，秦国就有机可乘了。这番话传到廉颇耳朵里，老将军羞愧极了，脱掉上衣、背着荆条，亲自登门请罪。两人从此成了同生共死的好朋友。",
   "meaning": "主动向对方认错赔罪，诚心诚意地道歉。",
   "clue": "蔺相如和廉颇的故事还有《完璧归赵》，都出自《史记·廉颇蔺相如列传》。",
   "pin_id": "dc61e00d-aee2-4ce4-baab-5598adaf0892",
   "entry_id": "dd9c3c91-3686-4ff5-a57d-57e43648a638",
   "sense_id": "6256d024-291e-4e36-ab2d-b578211658b7",
