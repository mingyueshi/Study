  "questions": [
    {
      "id": "count-the-words",
      "skill": "比字数",
      "prompt": "上联「晓雾藏山径」有五个字。哪句和它字数一样？",
      "choices": [
        "斜阳照水湾",
        "一轮斜阳照水湾",
        "水湾斜阳"
      ],
      "answer": 0,
      "hint": "从左到右点着数，一个汉字算一个。",
      "explanation": "「斜、阳、照、水、湾」一共五个字。"
    },
    {
      "id": "match-the-action",
      "skill": "找搭档",
      "prompt": "「春风摇翠柳」里的「摇」是动作。哪个字可以和它配对？",
      "choices": [
        "青",
        "苗",
        "润"
      ],
      "answer": 2,
      "hint": "想一想，夜雨对青苗做了什么？",
      "explanation": "「摇」和「润」都是动作，可以放在两句对应的位置。"
    },
    {
      "id": "listen-to-the-end",
      "skill": "听尾音",
      "prompt": "「夜雨润青苗」的最后一个字是「苗（miáo）」。它更适合做哪一联？",
      "choices": [
        "上联",
        "下联",
        "两边都一样"
      ],
      "answer": 1,
      "hint": "把「苗」念出来，听听它是第几声。",
      "explanation": "「苗」读第二声，是平声。按「上仄下平」，这句适合放下联。"
    },
    {
      "id": "pick-the-line",
      "skill": "选下联",
      "prompt": "给上联「翠竹摇风添雅趣」找一句最合适的下联。",
      "choices": [
        "山间一阵清风来",
        "红梅映雪报春信",
        "红梅映雪报春光"
      ],
      "answer": 2,
      "hint": "先找能和「翠竹」「摇风」配对的词，再听最后一个字。",
      "explanation": "「红梅」对「翠竹」，「映雪」对「摇风」。「光（guāng）」是一声，适合给下联收尾。"
    },
    {
      "id": "face-the-door",
      "skill": "贴春联",
      "prompt": "你站在门前，横批从右向左读。上联应该贴在哪边？",
      "choices": [
        "右边",
        "左边",
        "门的正中间"
      ],
      "answer": 0,
      "hint": "找到横批第一个字的位置，上联就跟它站在同一边。",
      "explanation": "面对门，横批从右边开始读，上联就贴在右边。"
    },
    {
      "id": "pick-the-banner",
      "skill": "配横批",
      "prompt": "「课上听佳句，窗前读好书」说的是读书。哪个横批最贴切？",
      "choices": [
        "五谷丰登",
        "书声琅琅",
        "山水如画"
      ],
      "answer": 1,
      "hint": "找一个和两句共同话题有关的四字词。",
      "explanation": "「书声琅琅」让人想到清亮的读书声，跟上下联的读书主题最合拍。"
    },
