{
  "schema_version": 1,
  "rules": [
    {
      "id": "count",
      "title": "数数有几个字",
      "text": "上联和下联的字数一样。一边五个字，另一边也要五个字。",
      "clue": "春风摇翠柳：五个字。夜雨润青苗：也是五个字。"
    },
    {
      "id": "match",
      "title": "给词找搭档",
      "text": "把两句按停顿切开，让同一位置的词互相照应。景物对景物，动作对动作，两句合起来说同一件事。",
      "clue": "「春风」对「夜雨」，「摇」对「润」，合起来写春天。"
    },
    {
      "id": "listen",
      "title": "听听最后一字",
      "text": "用普通话今声练习时，一、二声算平声，三、四声算仄声。入门先记「上仄下平」：上联收在仄声，下联收在平声。",
      "clue": "「柳」读 liǔ，第三声。「苗」读 miáo，第二声。"
    },
    {
      "id": "hang",
      "title": "跟着横批贴",
      "text": "面对门看，横批从哪边开始读，就把上联贴在哪边。传统横批从右向左读，上联贴右边。",
      "clue": "横批从左向右读时，上联就贴左边。"
    }
  ],
