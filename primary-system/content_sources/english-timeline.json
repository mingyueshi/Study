{
  "moments": [
    {"id":"habit", "label":"平时", "cue":"every day", "tense":"一般现在时", "rule":"说经常做的事。主语是 I，动词用原形；主语是 she，动词用第三人称单数形式。"},
    {"id":"now", "label":"正在", "cue":"now", "tense":"现在进行时", "rule":"说此刻正在做的事。用 be + 动词-ing，I 搭配 am，she 搭配 is。"},
    {"id":"past", "label":"昨天", "cue":"yesterday", "tense":"一般过去时", "rule":"说过去发生的事。I 和 she 在这些例句里用同一个过去式。"},
    {"id":"plan", "label":"明天的计划", "cue":"tomorrow", "tense":"用 be going to 说将来", "rule":"说已经有的打算。用 be going to + 动词原形，I 搭配 am，she 搭配 is。"}
  ],
  "actions": [
