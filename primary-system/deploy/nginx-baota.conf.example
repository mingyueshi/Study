# 宝塔「网站 → 设置 → 配置文件」整份替换示例，不是单独的反向代理片段。
# 适用：宿主机 Nginx 直接接收公网请求，Docker 应用绑定 127.0.0.1:8012。
# 其他域名请同时替换 server_name、跳转地址、证书、验证目录和日志路径。
upstream study_primary_app {
    server 127.0.0.1:8012;
    keepalive 16;
}

server {
    listen 80;
    listen 443 ssl;
    http2 on;
    server_name study.shimingyue.com;
    root /www/wwwroot/study.shimingyue.com;
    server_tokens off;

    include /www/server/panel/vhost/nginx/extension/study.shimingyue.com/*.conf;

    #CERT-APPLY-CHECK--START
    # 用于 SSL 证书申请时的文件验证相关配置，请勿删除。
    include /www/server/panel/vhost/nginx/well-known/study.shimingyue.com.conf;
    #CERT-APPLY-CHECK--END

    #SSL-START SSL相关配置，请勿删除或修改下一行带注释的404规则
    #error_page 404/404.html;
    ssl_certificate /www/server/panel/vhost/cert/study.shimingyue.com/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/study.shimingyue.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:STUDY_SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    error_page 497 =308 https://study.shimingyue.com$request_uri;
    #SSL-END

    # 公共代理参数由下面两个 location 继承；不要在其中仅覆盖部分请求头。
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header Connection "";
    proxy_set_header Upgrade "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 90s;
    proxy_redirect off;
    proxy_intercept_errors off;
    proxy_cache off;
    # 应用也会发送 HSTS，由入口统一输出，避免重复。
    proxy_hide_header Strict-Transport-Security;
    gzip off;

    # 证书验证文件由宿主机读取，不交给 Django，也不强制跳转 HTTPS。
    # 保留上方宝塔 include：面板生成的更具体规则仍可处理证书验证。
    location /.well-known/ {
        allow all;
        default_type text/plain;
        autoindex off;
        try_files $uri =404;
    }

    if ($uri ~* "^/\.well-known/.*\.(php|jsp|py|js|css|lua|ts|go|zip|tar\.gz|rar|7z|sql|sqlite3?|bak)$") {
        return 403;
    }

    # 普通前缀 location 不加 ^~，否则这些正则拦截规则会被跳过。
    location ~ /\.(?!well-known(?:/|$)) {
        return 404;
    }
    location ~* /(?:node_modules|runtime|__pycache__)(?:/|$) {
        return 404;
    }
    location ~* /(?:Dockerfile|Makefile|manage\.py|(?:docker-)?compose\.ya?ml|docker\.env|pyproject\.toml|requirements[^/]*\.txt|package(?:-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|README(?:\.md)?|AGENTS\.md|CLAUDE\.md|LICENSE)$ {
        return 404;
    }
    location ~* (?:\.(?:sql|sqlite3?)(?:\.(?:gz|bz2|xz|zip))?|\.(?:log|bak|backup|old|swp|swo|tmp|temp)|~)$ {
        return 404;
    }

    #PROXY-CONF-START
    # WhiteNoise 提供静态文件；保留它的 Cache-Control、ETag 和 Range 行为。
    location /static/ {
        if ($scheme = http) {
            return 308 https://study.shimingyue.com$request_uri;
        }
        proxy_pass http://study_primary_app;
        gzip on;
        gzip_vary on;
        gzip_min_length 1024;
        gzip_comp_level 4;
        gzip_types text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml;
    }

    # 登录、后台、学习记录与私有资料均由应用处理，不设置代理页面缓存。
    location / {
        if ($scheme = http) {
            return 308 https://study.shimingyue.com$request_uri;
        }
        proxy_pass http://study_primary_app;
    }
    #PROXY-CONF-END

    access_log /www/wwwlogs/study.shimingyue.com.log;
    error_log /www/wwwlogs/study.shimingyue.com.error.log warn;
}
